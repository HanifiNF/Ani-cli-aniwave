{
  "name": "ani-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A private desktop client built from ani-cli v5",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && node scripts/generate-icons.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64 --arm64",
    "start": "npm run build && electron .",
    "test:player": "npm run build && node scripts/run-player-integration.cjs",
    "test:player:native": "npm run build && cross-env ANI_PLAYER_NATIVE_TEST=1 node scripts/run-player-integration.cjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@vidstack/react": "1.15.6",
    "hls.js": "1.7.2",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "packageManager": "npm@10.9.8",
  "build": {
    "appId": "dev.hanifi.anidesktop",
    "productName": "ANIdesktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@vidstack/react/LICENSE",
        "to": "licenses/Vidstack-LICENSE"
      },
      {
        "from": "node_modules/hls.js/LICENSE",
        "to": "licenses/hls.js-LICENSE"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.video",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "dist-electron/icon.png",
      "category": "AudioVideo"
    }
  }
}
